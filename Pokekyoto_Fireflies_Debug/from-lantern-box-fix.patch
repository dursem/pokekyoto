+    -1, -2, -3, -4, -4, -5, -5, -5,
+};
+
+static const s8 sFireflyDriftY[32] =
+{
+     0, -1, -1, -2, -2, -2, -1, -1,
+     0,  1,  2,  2,  3,  3,  2,  2,
+     1,  0, -1, -2, -2, -3, -3, -2,
+    -2, -1,  0,  1,  1,  2,  1,  1,
+};

+u32 ProfileClock(void)
+{
+    u32 hi = REG_TM2CNT_L;
+    u32 lo = REG_TM1CNT_L;
+    if (hi != REG_TM2CNT_L) { hi = REG_TM2CNT_L; lo = REG_TM1CNT_L; }
+    return (hi << 16) | lo;
+}

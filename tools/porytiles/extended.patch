@@ -0,0 +1,49 @@
+#include "porytiles/domain/config/tile_id_layout_resolver.hpp"
+
+#include "porytiles/xcut/config/unwrap_config.hpp"
+
+namespace porytiles {
+
+ChainableResult<ResolvedTileIdLayout>
+resolve_tile_id_layout(const DomainConfig &config, const std::string &tileset_name)
+{
+    PT_UNWRAP_TILESET_CONFIG_REF(config, num_tiles_in_primary, tileset_name, ResolvedTileIdLayout);
+    PT_UNWRAP_TILESET_CONFIG_REF(config, num_tiles_total, tileset_name, ResolvedTileIdLayout);
+    PT_UNWRAP_TILESET_CONFIG_REF(config, num_tiles_in_primary_extended, tileset_name, ResolvedTileIdLayout);
+    PT_UNWRAP_TILESET_CONFIG_REF(config, num_tiles_in_secondary_extended, tileset_name, ResolvedTileIdLayout);
+
+    if (num_tiles_in_primary_extended.value() == 0 && num_tiles_in_secondary_extended.value() == 0) {
+        return ResolvedTileIdLayout{
+            TileIdLayout{num_tiles_in_primary.value(), num_tiles_total.value()},
+            num_tiles_in_primary,
+            num_tiles_total,
+            std::nullopt};
+    }
+
+    auto layout = TileIdLayout::extended(
+        num_tiles_in_primary.value(),
+        num_tiles_total.value(),
+        num_tiles_in_primary_extended.value(),
+        num_tiles_in_secondary_extended.value());
+    if (!layout.has_value()) {
+        return FormattableError{
+            "Extended tile limits '{}' (primary) and '{}' (secondary) must each be at least the hardware limits '{}' "
+            "and '{}', and together fit in {}-bit tile ids.",
+            FormatParam{num_tiles_in_primary_extended.value(), Style::bold},
+            FormatParam{num_tiles_in_secondary_extended.value(), Style::bold},
+            FormatParam{num_tiles_in_primary.value(), Style::bold},
+            FormatParam{num_tiles_total.value() - num_tiles_in_primary.value(), Style::bold},
+            FormatParam{TileIdLayout::game_id_bits}};
+    }
+
+    ConfigValue<std::size_t> total_limit{
+        layout->num_tiles_total(),
+        num_tiles_in_primary_extended.canonical_name() + " + " + num_tiles_in_secondary_extended.canonical_name(),
+        num_tiles_in_secondary_extended.source_key(),
+        num_tiles_in_secondary_extended.source(),
+        num_tiles_in_secondary_extended.source_details()};
+    return ResolvedTileIdLayout{
+        layout.value(), num_tiles_in_primary_extended, std::move(total_limit), num_tiles_in_secondary_extended};
+}
+
+} // namespace porytiles

@@ -0,0 +1,37 @@
+#pragma once
+
+#include <filesystem>
+#include <string>
+
+#include "porytiles/domain/config/domain_config.hpp"
+#include "porytiles/domain/models/porymap_tileset_component.hpp"
+#include "porytiles/infra/services/file_palette_loader.hpp"
+#include "porytiles/utilities/result/chainable_result.hpp"
+
+namespace porytiles {
+
+/// @brief Loads a tileset's metatiles.bin into @p dest, with the project's extended tile ids and extra palettes.
+///
+/// @details
+/// Reads metatile_tiles_ext.bin beside metatiles.bin when the project uses extended tile ids and converts every entry
+/// to contiguous tile ids. For a tileset listed in data/tilesets/map_palettes.json, or a secondary tileset whose
+/// extra_palettes config is on, enables the tileset's extra palettes, loads their colors, and replaces each entry's
+/// palette with its logical palette from palette_refs.json.
+///
+/// @param dest The component to append entries and extra palettes to
+/// @param tileset_name The tileset's name, for config lookup and the manifest
+/// @param is_secondary Whether the tileset is secondary; only secondary tilesets can enable extra palettes
+/// @param project_root The project root
+/// @param metatiles_path metatiles.bin, relative to @p project_root

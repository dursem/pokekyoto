+// Builds a tileset whose bottom layer holds one 8x8 subtile per entry of subtile_colors, each drawn from its own color
+// group. Metatiles are laid out 8 per row; unused subtiles are transparent.
+Tileset build_patterned_tileset(const std::string &name, const std::vector<std::vector<Rgba32>> &subtile_colors)
+{
+    const std::size_t metatile_count = (subtile_colors.size() + 3) / 4;
+    const std::size_t rows = (metatile_count + 7) / 8;
+    Image<Rgba32> bottom{128, rows * 16, rgba_magenta};
+    std::uint32_t seed = 12345;
+    for (std::size_t subtile = 0; subtile < subtile_colors.size(); ++subtile) {
+        const std::size_t metatile = subtile / 4;
+        const std::size_t x0 = (metatile % 8) * 16 + (subtile % 2) * 8;
+        const std::size_t y0 = (metatile / 8) * 16 + (subtile % 4 / 2) * 8;
+        const auto &colors = subtile_colors.at(subtile);
+        for (std::size_t row = 0; row < 8; ++row) {
+            for (std::size_t col = 0; col < 8; ++col) {
+                seed = seed * 1103515245u + 12345u;
+                bottom.set(y0 + row, x0 + col, colors.at((seed >> 16) % colors.size()));
+            }
+        }
+    }
+
+    auto porytiles_component = std::make_unique<PorytilesTilesetComponent>();
+    porytiles_component->bottom(bottom);
+    porytiles_component->middle(Image<Rgba32>{128, rows * 16, rgba_magenta});
+    porytiles_component->top(Image<Rgba32>{128, rows * 16, rgba_magenta});
+    auto porymap_component = std::make_unique<PorymapTilesetComponent>();
+    return Tileset{name, std::move(porytiles_component), std::move(porymap_component)};
+}
+
+// A group of distinct colors, disjoint from every other group index.
+std::vector<Rgba32> color_group(std::size_t group, std::size_t count)
+{
+    std::vector<Rgba32> colors;
+    for (std::size_t i = 0; i < count; ++i) {
+        colors.emplace_back(
+            static_cast<std::uint8_t>(8 * (group % 32)),
+            static_cast<std::uint8_t>(8 * (i + 1)),
+            static_cast<std::uint8_t>(8 * (group / 32 + 1)),
+            255);
+    }
+    return colors;
+}
+

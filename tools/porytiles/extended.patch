@@ -0,0 +1,89 @@
+#include "porytiles/infra/services/palette_manifest.hpp"
+
+#include <fstream>
+#include <iterator>
+#include <utility>
+
+#include "nlohmann/json.hpp"
+
+namespace {
+
+using namespace porytiles;
+
+ChainableResult<nlohmann::ordered_json> load_manifest(const std::filesystem::path &path)
+{
+    if (!std::filesystem::exists(path)) {
+        return nlohmann::ordered_json{{"version", 1}, {"tilesets", nlohmann::ordered_json::array()}};
+    }
+    std::ifstream in{path, std::ios::binary};
+    const std::string text{std::istreambuf_iterator<char>(in), {}};
+    auto manifest = nlohmann::ordered_json::parse(text, nullptr, false);
+    if (manifest.is_discarded() || !manifest.is_object() || manifest.value("version", 0) != 1 ||
+        !manifest.contains("tilesets") || !manifest["tilesets"].is_array()) {
+        return FormattableError{
+            "'{}' is not a version 1 palette manifest.", FormatParam{path.string(), Style::bold}};
+    }
+    return manifest;
+}
+
+} // namespace
+
+namespace porytiles {
+
+PaletteManifest::PaletteManifest(std::filesystem::path project_root) : project_root_{std::move(project_root)} {}
+
+ChainableResult<std::optional<PaletteManifestEntry>>
+PaletteManifest::entry_for(const std::string &tileset_name) const
+{
+    const auto path = project_root_ / relative_path;
+    PT_TRY_ASSIGN_PASS_ERR(manifest, load_manifest(path), std::optional<PaletteManifestEntry>);
+
+    std::optional<PaletteManifestEntry> result{};
+    for (const auto &spec : manifest["tilesets"]) {
+        if (!spec.is_object() || spec.value("tileset", std::string{}) != tileset_name) {
+            continue;
+        }
+        const auto &palettes = spec.contains("palettes") ? spec["palettes"] : nlohmann::ordered_json{};
+        if (result.has_value() || !spec.contains("palette_refs") || !spec["palette_refs"].is_string() ||
+            !palettes.is_array() || palettes.size() != PaletteManifestEntry::num_extra_palettes) {
+            return FormattableError{
+                "'{}' has an invalid or duplicate entry for '{}'.",
+                FormatParam{path.string(), Style::bold},
+                FormatParam{tileset_name, Style::bold}};
+        }
+        PaletteManifestEntry entry{};
+        entry.palette_refs = spec["palette_refs"].get<std::string>();
+        for (std::size_t i = 0; i < PaletteManifestEntry::num_extra_palettes; ++i) {
+            if (!palettes[i].is_object() || !palettes[i].contains("day") || !palettes[i]["day"].is_string()) {
+                return FormattableError{
+                    "Extra palette '{}' of '{}' in '{}' has no day palette.",
+                    FormatParam{i, Style::bold},
+                    FormatParam{tileset_name, Style::bold},
+                    FormatParam{path.string(), Style::bold}};
+            }
+            entry.palettes[i] = palettes[i]["day"].get<std::string>();
+        }
+        result = std::move(entry);
+    }
+    return result;
+}
+
+ChainableResult<std::string>
+PaletteManifest::with_entry(const std::string &tileset_name, const PaletteManifestEntry &entry) const
+{
+    PT_TRY_ASSIGN_PASS_ERR(manifest, load_manifest(project_root_ / relative_path), std::string);
+
+    auto palettes = nlohmann::ordered_json::array();
+    for (const auto &palette : entry.palettes) {
+        palettes.push_back({{"day", palette.generic_string()}});
+    }
+    manifest["tilesets"].push_back(
+        {{"tileset", tileset_name},
+         {"palette_refs", entry.palette_refs.generic_string()},
+         {"palettes", std::move(palettes)},
+         {"effects", nlohmann::ordered_json::array()},
+         {"dynamic_metatiles", nlohmann::ordered_json::array()}});
+    return manifest.dump(2) + "\n";
+}
+
+} // namespace porytiles

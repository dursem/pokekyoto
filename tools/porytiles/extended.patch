+ChainableResult<bool> ProjectPorytilesTilesetManager::ensure_uncompressed_tiles(const std::string &tileset_name) const
+{
+    PT_TRY_ASSIGN_CHAIN_ERR(
+        metadata,
+        metadata_provider_->metadata_for(tileset_name),
+        bool,

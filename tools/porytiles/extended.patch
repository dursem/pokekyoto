+void PorymapTilesetComponent::enable_extra_palettes(std::size_t base, std::size_t count)
+{
+    extra_palette_base_ = base;
+    extra_palettes_.assign(count, Palette<Rgba32, palette::max_size>{Rgba32{0, 0, 0, Rgba32::alpha_opaque}});
+}
+
+void PorymapTilesetComponent::set_extra_palette(std::size_t extra_index, Palette<Rgba32, palette::max_size> palette)
+{
+    if (extra_index >= extra_palettes_.size()) {
+        panic(std::format("invalid extra palette index {}: out of range", extra_index));
+    }
+    extra_palettes_.at(extra_index) = std::move(palette);
+}
+
+std::size_t PorymapTilesetComponent::num_logical_palettes() const
+{
+    return has_extra_palettes() ? std::max(palette::num_palettes, extra_palette_base_ + extra_palettes_.size())
+                                : palette::num_palettes;
+}
+
+const Palette<Rgba32, palette::max_size> &PorymapTilesetComponent::logical_palette_at(std::size_t palette_index) const
+{
+    if (has_extra_palettes() && palette_index >= extra_palette_base_ &&
+        palette_index < extra_palette_base_ + extra_palettes_.size()) {
+        return extra_palettes_.at(palette_index - extra_palette_base_);
+    }
+    return palette_at(palette_index);
+}
+
+std::vector<Palette<Rgba32, palette::max_size>> PorymapTilesetComponent::logical_palettes() const
+{
+    std::vector<Palette<Rgba32, palette::max_size>> result;
+    result.reserve(num_logical_palettes());
+    for (std::size_t i = 0; i < num_logical_palettes(); ++i) {
+        result.push_back(logical_palette_at(i));
+    }
+    return result;
+}

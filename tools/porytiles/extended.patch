+namespace {
+
+TileIdLayout extended_layout()
+{
+    return TileIdLayout::extended(512, 1024, 1024, 2048).value();
+}
+
+void write_bytes(const std::filesystem::path &path, const std::vector<std::uint8_t> &bytes)
+{
+    std::filesystem::create_directories(path.parent_path());
+    std::ofstream out{path, std::ios::binary};
+    out.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+}
+
+void write_text(const std::filesystem::path &path, const std::string &text)
+{
+    write_bytes(path, std::vector<std::uint8_t>{text.begin(), text.end()});
+}
+
+std::string read_text(const std::filesystem::path &path)
+{
+    std::ifstream in{path, std::ios::binary};
+    return std::string{std::istreambuf_iterator<char>(in), {}};
+}
+
+} // namespace
+
+class ExtendedTilesetFormatsTest : public ::testing::Test {
+  protected:
+    void SetUp() override
+    {
+        std::random_device device;
+        dir_ = std::filesystem::temp_directory_path() / ("porytiles_extended_formats_" + std::to_string(device()));
+        std::filesystem::create_directories(dir_);
+    }
+
+    void TearDown() override
+    {
+        std::filesystem::remove_all(dir_);
+    }
+
+    std::filesystem::path dir_;
+};
+
+TEST_F(ExtendedTilesetFormatsTest, EncodeSplitsHighTileBitsIntoSidecar)
+{
+    const std::vector<TilemapEntry> entries{{600, 3, true, false}, {1030, 7, false, true}, {1600, 8, false, false}};
+
+    const auto encoded = encode_metatiles(entries, extended_layout(), std::nullopt, 12).value();
+
+    ASSERT_EQ(encoded.metatiles_bin.size(), 6);
+    EXPECT_TRUE(encoded.needs_tiles_ext);
+    // Primary tile 600 is game id 1112: low bits 88, high bits 1
+    EXPECT_EQ(encoded.metatiles_bin[0] | (encoded.metatiles_bin[1] << 8), 88 | (1 << 10) | (3 << 12));
+    EXPECT_EQ(encoded.tiles_ext[0], 1 << metatile_tiles_ext_high_shift);
+    // Secondary tile 6 is game id 518, which needs no high bits
+    EXPECT_EQ(encoded.metatiles_bin[2] | (encoded.metatiles_bin[3] << 8), 518 | (1 << 11) | (7 << 12));
+    EXPECT_EQ(encoded.tiles_ext[1], 0);
+    // Secondary tile 576 is game id 1600: low bits 576, high bits 1
+    EXPECT_EQ(encoded.metatiles_bin[4] | (encoded.metatiles_bin[5] << 8), 576 | (8 << 12));
+    EXPECT_EQ(encoded.tiles_ext[2], 1 << metatile_tiles_ext_high_shift);
+    EXPECT_FALSE(encoded.palette_refs_json.has_value());
+}
+
+TEST_F(ExtendedTilesetFormatsTest, EncodeWithoutHighTilesNeedsNoSidecar)
+{
+    const std::vector<TilemapEntry> entries{{5, 0, false, false}, {1030, 6, false, false}};
+
+    const auto encoded = encode_metatiles(entries, extended_layout(), std::nullopt, 12).value();
+
+    EXPECT_FALSE(encoded.needs_tiles_ext);
+}
+
+TEST_F(ExtendedTilesetFormatsTest, EncodeRejectsTilesPastLimit)
+{
+    const std::vector<TilemapEntry> entries{{3072, 0, false, false}};
+
+    EXPECT_FALSE(encode_metatiles(entries, extended_layout(), std::nullopt, 12).has_value());
+}
+
+TEST_F(ExtendedTilesetFormatsTest, ReadRoundTripsThroughSidecar)
+{
+    std::vector<TilemapEntry> entries;
+    for (std::size_t i = 0; i < 24; ++i) {
+        entries.emplace_back(i * 127 % 3072, i % 14, i % 2 == 0, i % 3 == 0);
+    }
+    const auto encoded = encode_metatiles(entries, extended_layout(), std::nullopt, 12).value();
+    write_bytes(dir_ / "metatiles.bin", encoded.metatiles_bin);
+    write_bytes(dir_ / metatile_tiles_ext_filename, encoded.tiles_ext);
+
+    const auto read = read_metatiles_with_tiles_ext(dir_ / "metatiles.bin", extended_layout()).value();
+
+    ASSERT_EQ(read.size(), entries.size());
+    for (std::size_t i = 0; i < entries.size(); ++i) {
+        EXPECT_EQ(read[i].tile_index(), entries[i].tile_index());
+        EXPECT_EQ(read[i].palette_index(), entries[i].palette_index());
+        EXPECT_EQ(read[i].h_flip(), entries[i].h_flip());
+        EXPECT_EQ(read[i].v_flip(), entries[i].v_flip());
+    }
+}
+
+TEST_F(ExtendedTilesetFormatsTest, ReadRejectsSidecarOfWrongSize)
+{
+    write_bytes(dir_ / "metatiles.bin", {0, 0, 0, 0});
+    write_bytes(dir_ / metatile_tiles_ext_filename, {0});
+
+    EXPECT_FALSE(read_metatiles_with_tiles_ext(dir_ / "metatiles.bin", extended_layout()).has_value());
+}
+
+TEST_F(ExtendedTilesetFormatsTest, ReadIgnoresSidecarWithoutExtendedLayout)
+{
+    write_bytes(dir_ / "metatiles.bin", {0x10, 0x02});
+    write_bytes(dir_ / metatile_tiles_ext_filename, {1 << metatile_tiles_ext_high_shift});
+
+    const auto read = read_metatiles_with_tiles_ext(dir_ / "metatiles.bin", TileIdLayout{512, 1024}).value();
+
+    EXPECT_EQ(read.at(0).tile_index(), 0x210);
+}
+
+TEST_F(ExtendedTilesetFormatsTest, PaletteRefsRoundTrip)
+{
+    std::vector<TilemapEntry> entries;
+    for (std::size_t i = 0; i < 12; ++i) {
+        entries.emplace_back(1024 + i, 6 + i % 12, false, false);
+    }
+    const auto encoded = encode_metatiles(entries, extended_layout(), 14, 12).value();
+    ASSERT_TRUE(encoded.palette_refs_json.has_value());
+    write_text(dir_ / palette_refs_filename, encoded.palette_refs_json.value());
+    // Extra palettes keep palette 0 in the hardware nibble
+    EXPECT_EQ(encoded.metatiles_bin[2 * 8 + 1] >> 4, 0);
+
+    write_bytes(dir_ / "metatiles.bin", encoded.metatiles_bin);
+    auto read = read_metatiles_with_tiles_ext(dir_ / "metatiles.bin", extended_layout()).value();
+    ASSERT_TRUE(apply_palette_refs(dir_ / palette_refs_filename, encoded.metatiles_bin, read, 18).has_value());
+
+    for (std::size_t i = 0; i < entries.size(); ++i) {
+        EXPECT_EQ(read[i].palette_index(), entries[i].palette_index());
+    }
+}
+
+TEST_F(ExtendedTilesetFormatsTest, PaletteRefsRejectChecksumMismatch)
+{
+    std::vector<TilemapEntry> entries(12, TilemapEntry{1024, 15, false, false});
+    const auto encoded = encode_metatiles(entries, extended_layout(), 14, 12).value();
+    write_text(dir_ / palette_refs_filename, encoded.palette_refs_json.value());
+    auto edited = encoded.metatiles_bin;
+    edited[0] ^= 1;
+
+    EXPECT_FALSE(apply_palette_refs(dir_ / palette_refs_filename, edited, entries, 18).has_value());
+}
+
+TEST_F(ExtendedTilesetFormatsTest, ManifestLookupAndAppend)
+{
+    const PaletteManifest manifest{dir_};
+    EXPECT_FALSE(manifest.entry_for("gTileset_Foo").value().has_value());
+
+    PaletteManifestEntry entry{};
+    entry.palette_refs = "data/tilesets/secondary/foo/palette_refs.json";
+    for (std::size_t i = 0; i < entry.palettes.size(); ++i) {
+        entry.palettes.at(i) = "data/tilesets/secondary/foo/palettes/extra_" + std::to_string(i) + ".pal";
+    }
+    write_text(dir_ / PaletteManifest::relative_path, manifest.with_entry("gTileset_Foo", entry).value());
+
+    const auto found = manifest.entry_for("gTileset_Foo").value();
+    ASSERT_TRUE(found.has_value());
+    EXPECT_EQ(found->palette_refs, entry.palette_refs);
+    EXPECT_EQ(found->palettes.at(3), entry.palettes.at(3));
+    EXPECT_NE(
+        read_text(dir_ / PaletteManifest::relative_path).find("\"dynamic_metatiles\": []"), std::string::npos);
+    EXPECT_FALSE(manifest.entry_for("gTileset_Bar").value().has_value());
+}
+
+TEST_F(ExtendedTilesetFormatsTest, ManifestRejectsMalformedEntry)
+{
+    write_text(
+        dir_ / PaletteManifest::relative_path,
+        R"({"version": 1, "tilesets": [{"tileset": "gTileset_Foo", "palette_refs": "x.json", "palettes": []}]})");
+
+    EXPECT_FALSE(PaletteManifest{dir_}.entry_for("gTileset_Foo").has_value());
+}

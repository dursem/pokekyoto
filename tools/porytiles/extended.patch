+TEST(TileIdLayoutTests, ExtendedGameIdRanges)
+{
+    const auto layout = extended_layout();
+
+    EXPECT_EQ(layout.to_internal(511), 511);
+    EXPECT_EQ(layout.to_internal(512), 1024);
+    EXPECT_EQ(layout.to_internal(1023), 1535);
+    EXPECT_EQ(layout.to_internal(1024), 512);
+    EXPECT_EQ(layout.to_internal(1535), 1023);
+    EXPECT_EQ(layout.to_internal(1536), 1536);
+    EXPECT_EQ(layout.to_internal(3071), 3071);
+    EXPECT_FALSE(layout.to_internal(3072).has_value());
+}
+
+TEST(TileIdLayoutTests, ExtendedRoundTrip)
+{
+    const auto layout = extended_layout();
+
+    for (std::size_t internal = 0; internal < layout.num_tiles_total(); ++internal) {
+        EXPECT_EQ(layout.to_internal(layout.to_game(internal)), internal);
+    }
+}
+
+TEST(TileIdLayoutTests, ExtendedRejectsSizesBelowHardware)
+{
+    EXPECT_FALSE(TileIdLayout::extended(512, 1024, 256, 2048).has_value());
+    EXPECT_FALSE(TileIdLayout::extended(512, 1024, 1024, 256).has_value());
+}
+
+TEST(TileIdLayoutTests, ExtendedRejectsIdsPastTwelveBits)
+{
+    EXPECT_FALSE(TileIdLayout::extended(512, 1024, 2048, 2049).has_value());
+    EXPECT_TRUE(TileIdLayout::extended(512, 1024, 2048, 2048).has_value());
+}

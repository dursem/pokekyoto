new file mode 100644
index 0000000..36fe663
--- /dev/null
+++ b/porytiles/include/porytiles/domain/models/tile_id_layout.hpp
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <cstddef>
+#include <optional>
+
+namespace porytiles {
+
+/// @brief Maps between the tile ids a project stores in metatiles.bin and the contiguous ids Porytiles works with.
+///
+/// @details
+/// Porytiles numbers tiles contiguously: primary tiles occupy [0, num_tiles_in_primary()) and secondary tiles occupy
+/// [num_tiles_in_primary(), num_tiles_total()). A vanilla project stores the same numbers in metatiles.bin, so its
+/// layout is the identity.
+///
+/// A project with extended tile ids (for example the project's streamed tilesets) lets tilesets exceed the hardware
+/// VRAM split. Its metatile entries keep the 10-bit hardware tile field and store two more bits in
+/// metatile_tiles_ext.bin, numbered so that every hardware id keeps its meaning:
+///
+/// | Game id range                               | Tile                                     |
+/// |---------------------------------------------|------------------------------------------|
+/// | [0, hw_primary)                             | primary 0 .. hw_primary-1                |
+/// | [hw_primary, hw_total)                      | secondary 0 .. hw_total-hw_primary-1     |
+/// | [hw_total, hw_total+ext_primary-hw_primary) | primary hw_primary .. ext_primary-1      |
+/// | above that                                  | the rest of the secondary tiles          |
+///
+/// With the default values (512, 1024, 1024, 2048) this is 0-511 primary, 512-1023 secondary, 1024-1535 primary 512-1023,
+/// 1536-3071 secondary 512-2047.
+class TileIdLayout {
+  public:
+    /// @brief Number of game tile id bits: 10 in metatiles.bin plus 2 in metatile_tiles_ext.bin.
+    static constexpr std::size_t game_id_bits = 12;
+
+    /// @brief Constructs the identity layout of a vanilla project.
+    TileIdLayout(std::size_t hw_primary, std::size_t hw_total);
+
+    /// @brief Constructs an extended layout, or nullopt when the sizes don't describe one that fits in 12-bit ids.
+    ///
+    /// @pre hw_primary <= hw_total
+    [[nodiscard]] static std::optional<TileIdLayout>
+    extended(std::size_t hw_primary, std::size_t hw_total, std::size_t ext_primary, std::size_t ext_secondary);
+
+    [[nodiscard]] bool is_extended() const
+    {
+        return extended_;
+    }
+
+    /// @brief Primary tile capacity, which is also the first contiguous secondary id.
+    [[nodiscard]] std::size_t num_tiles_in_primary() const
+    {
+        return primary_;
+    }
+
+    /// @brief Primary plus secondary tile capacity in contiguous ids.
+    [[nodiscard]] std::size_t num_tiles_total() const
+    {
+        return primary_ + secondary_;
+    }
+
+    /// @brief Number of tile ids the hardware tile field of a tilemap entry can address.
+    [[nodiscard]] std::size_t hw_total() const
+    {
+        return hw_total_;
+    }
+
+    /// @brief Converts a game tile id to a contiguous id, or nullopt when the id names no tile of this layout.
+    [[nodiscard]] std::optional<std::size_t> to_internal(std::size_t game_id) const;
+
+    /// @brief Converts a contiguous id to the game tile id stored across metatiles.bin and metatile_tiles_ext.bin.
+    ///
+    /// @pre internal_id < num_tiles_total()
+    [[nodiscard]] std::size_t to_game(std::size_t internal_id) const;
+
+  private:
+    TileIdLayout(
+        std::size_t hw_primary, std::size_t hw_total, std::size_t primary, std::size_t secondary, bool extended);
+
+    std::size_t hw_primary_;
+    std::size_t hw_total_;
+    std::size_t primary_;
+    std::size_t secondary_;
+    bool extended_;
+};
+
+} // namespace porytiles

diff --git a/porytiles/lib/infra/algorithms/extended_tileset_formats.cpp b/porytiles/lib/infra/algorithms/extended_tileset_formats.cpp
new file mode 100644
index 0000000..73c011d
--- /dev/null
+++ b/porytiles/lib/infra/algorithms/extended_tileset_formats.cpp
@@ -0,0 +1,202 @@
+#include "porytiles/infra/algorithms/extended_tileset_formats.hpp"
+
+#include <fstream>
+#include <iterator>
+
+#include "nlohmann/json.hpp"
+
+#include "porytiles/utilities/sha256.hpp"
+
+namespace {
+
+using namespace porytiles;
+
+constexpr std::size_t hw_tile_bits = 10;
+constexpr std::uint16_t hw_tile_mask = (1u << hw_tile_bits) - 1;
+constexpr std::size_t hflip_shift = 10;
+constexpr std::size_t vflip_shift = 11;
+constexpr std::size_t palette_shift = 12;
+constexpr std::uint16_t palette_nibble_mask = 0xF;
+
+ChainableResult<std::vector<std::uint8_t>> read_bytes(const std::filesystem::path &path)
+{
+    std::ifstream in{path, std::ios::binary};
+    if (!in) {
+        return FormattableError{"Failed to open '{}'.", FormatParam{path.string(), Style::bold}};
+    }
+    return std::vector<std::uint8_t>{std::istreambuf_iterator<char>(in), {}};
+}
+
+} // namespace
+
+namespace porytiles {
+
+ChainableResult<std::vector<TilemapEntry>>
+read_metatiles_with_tiles_ext(const std::filesystem::path &metatiles_path, const TileIdLayout &layout)
+{
+    PT_TRY_ASSIGN_PASS_ERR(data, read_bytes(metatiles_path), std::vector<TilemapEntry>);
+    if (data.size() % 2 != 0) {
+        return FormattableError{
+            "Size of '{}' is not a multiple of 2 bytes, possibly corrupted.",
+            FormatParam{metatiles_path.string(), Style::bold}};
+    }
+    const std::size_t entry_count = data.size() / 2;
+
+    std::vector<std::uint8_t> tiles_ext{};
+    const auto ext_path = metatiles_path.parent_path() / metatile_tiles_ext_filename;
+    if (layout.is_extended() && std::filesystem::exists(ext_path)) {
+        PT_TRY_ASSIGN_PASS_ERR(ext_bytes, read_bytes(ext_path), std::vector<TilemapEntry>);
+        if (ext_bytes.size() != entry_count) {
+            return FormattableError{
+                "'{}' has '{}' entries but '{}' has '{}'. Save them together.",
+                FormatParam{ext_path.string(), Style::bold},
+                FormatParam{ext_bytes.size(), Style::bold},
+                FormatParam{metatiles_path.string(), Style::bold},
+                FormatParam{entry_count, Style::bold}};
+        }
+        tiles_ext = std::move(ext_bytes);
+    }
+
+    std::vector<TilemapEntry> entries;
+    entries.reserve(entry_count);
+    for (std::size_t i = 0; i < entry_count; ++i) {
+        const auto bits = static_cast<std::uint16_t>(data[i * 2] | (data[i * 2 + 1] << 8));
+        std::size_t game_id = bits & hw_tile_mask;
+        if (!tiles_ext.empty()) {
+            game_id |= std::size_t{(tiles_ext[i] & metatile_tiles_ext_high_mask) >> metatile_tiles_ext_high_shift}
+                       << hw_tile_bits;
+        }
+        const auto internal_id = layout.to_internal(game_id);
+        if (!internal_id.has_value()) {
+            return FormattableError{
+                "Entry '{}' of '{}' references tile id '{}', which is outside the configured tile limits.",
+                FormatParam{i, Style::bold},
+                FormatParam{metatiles_path.string(), Style::bold},
+                FormatParam{game_id, Style::bold}};
+        }
+        entries.emplace_back(
+            internal_id.value(),
+            (bits >> palette_shift) & palette_nibble_mask,
+            ((bits >> hflip_shift) & 1u) != 0,
+            ((bits >> vflip_shift) & 1u) != 0);
+    }
+    return entries;
+}
+
+ChainableResult<void> apply_palette_refs(
+    const std::filesystem::path &refs_path,
+    const std::vector<std::uint8_t> &metatiles_bin,
+    std::vector<TilemapEntry> &entries,
+    std::size_t max_logical_palettes)
+{
+    PT_TRY_ASSIGN_PASS_ERR(text, read_bytes(refs_path), void);
+    const auto refs = nlohmann::json::parse(text.begin(), text.end(), nullptr, false);
+    if (refs.is_discarded() || !refs.is_object() || refs.value("version", 0) != 1 || !refs.contains("palettes") ||
+        !refs["palettes"].is_array()) {
+        return FormattableError{
+            "'{}' is not a version 1 palette sidecar.", FormatParam{refs_path.string(), Style::bold}};
+    }
+    if (refs.value("metatiles_sha256", std::string{}) != sha256_hex(metatiles_bin)) {
+        return FormattableError{
+            "'{}' does not match its metatiles.bin checksum. Save the paired files together.",
+            FormatParam{refs_path.string(), Style::bold}};
+    }
+
+    const auto &rows = refs["palettes"];
+    const std::size_t row_width = rows.empty() ? 0 : entries.size() / rows.size();
+    if (rows.empty() ? !entries.empty() : (row_width * rows.size() != entries.size())) {
+        return FormattableError{
+            "'{}' has '{}' rows, which does not divide the '{}' entries of its metatiles.bin.",
+            FormatParam{refs_path.string(), Style::bold},
+            FormatParam{rows.size(), Style::bold},
+            FormatParam{entries.size(), Style::bold}};
+    }
+    for (std::size_t metatile = 0; metatile < rows.size(); ++metatile) {
+        const auto &row = rows[metatile];
+        if (!row.is_array() || row.size() != row_width) {
+            return FormattableError{
+                "Row '{}' of '{}' needs '{}' palette ids.",
+                FormatParam{metatile, Style::bold},
+                FormatParam{refs_path.string(), Style::bold},
+                FormatParam{row_width, Style::bold}};
+        }
+        for (std::size_t subtile = 0; subtile < row_width; ++subtile) {
+            const auto &id = row[subtile];
+            if (!id.is_number_unsigned() || id.get<std::size_t>() >= max_logical_palettes) {
+                return FormattableError{
+                    "Row '{}' of '{}' has an invalid palette id.",
+                    FormatParam{metatile, Style::bold},
+                    FormatParam{refs_path.string(), Style::bold}};
+            }
+            entries[metatile * row_width + subtile].palette_index(id.get<std::size_t>());
+        }
+    }
+    return {};
+}
+
+ChainableResult<EncodedMetatiles> encode_metatiles(
+    const std::vector<TilemapEntry> &entries,
+    const TileIdLayout &layout,
+    std::optional<std::size_t> extra_palette_base,
+    std::size_t entries_per_metatile)
+{
+    EncodedMetatiles result{};
+    result.metatiles_bin.reserve(entries.size() * 2);
+    result.tiles_ext.reserve(entries.size());
+    for (std::size_t i = 0; i < entries.size(); ++i) {
+        const auto &entry = entries[i];
+        if (entry.tile_index() >= layout.num_tiles_total()) {
+            return FormattableError{
+                "Entry '{}' references tile '{}', past the tile limit '{}'.",
+                FormatParam{i, Style::bold},
+                FormatParam{entry.tile_index(), Style::bold},
+                FormatParam{layout.num_tiles_total(), Style::bold}};
+        }
+        std::size_t nibble = entry.palette_index();
+        if (extra_palette_base.has_value() && nibble >= extra_palette_base.value()) {
+            nibble = 0;
+        }
+        if (nibble > palette_nibble_mask) {
+            return FormattableError{
+                "Entry '{}' uses palette '{}', which does not fit the 4-bit palette field.",
+                FormatParam{i, Style::bold},
+                FormatParam{entry.palette_index(), Style::bold}};
+        }
+
+        const std::size_t game_id = layout.to_game(entry.tile_index());
+        const auto bits = static_cast<std::uint16_t>(
+            (game_id & hw_tile_mask) | (std::uint16_t{entry.h_flip()} << hflip_shift) |
+            (std::uint16_t{entry.v_flip()} << vflip_shift) | (nibble << palette_shift));
+        result.metatiles_bin.push_back(static_cast<std::uint8_t>(bits));
+        result.metatiles_bin.push_back(static_cast<std::uint8_t>(bits >> 8));
+
+        const auto high = static_cast<std::uint8_t>((game_id >> hw_tile_bits) << metatile_tiles_ext_high_shift);
+        result.tiles_ext.push_back(high);
+        result.needs_tiles_ext |= high != 0;
+    }
+
+    if (extra_palette_base.has_value()) {
+        if (entries_per_metatile == 0 || entries.size() % entries_per_metatile != 0) {
+            return FormattableError{
+                "'{}' entries do not form whole metatiles of '{}' entries.",
+                FormatParam{entries.size()},
+                FormatParam{entries_per_metatile}};
+        }
+        auto rows = nlohmann::json::array();
+        for (std::size_t first = 0; first < entries.size(); first += entries_per_metatile) {
+            auto row = nlohmann::json::array();
+            for (std::size_t i = first; i < first + entries_per_metatile; ++i) {
+                row.push_back(entries[i].palette_index());
+            }
+            rows.push_back(std::move(row));
+        }
+        nlohmann::ordered_json refs{};
+        refs["version"] = 1;
+        refs["metatiles_sha256"] = sha256_hex(result.metatiles_bin);
+        refs["palettes"] = std::move(rows);
+        result.palette_refs_json = refs.dump(2) + "\n";
+    }
+    return result;
+}
+
+} // namespace porytiles
diff --git a/porytiles/lib/infra/algorithms/project_metatiles_io.cpp b/porytiles/lib/infra/algorithms/project_metatiles_io.cpp
new file mode 100644
index 0000000..26c99f9
--- /dev/null
+++ b/porytiles/lib/infra/algorithms/project_metatiles_io.cpp
@@ -0,0 +1,69 @@
+#include "porytiles/infra/algorithms/project_metatiles_io.hpp"
+
+#include <fstream>
+#include <iterator>
+#include <vector>
+
+#include "porytiles/domain/config/tile_id_layout_resolver.hpp"
+#include "porytiles/infra/algorithms/extended_tileset_formats.hpp"
+#include "porytiles/infra/algorithms/porymap_artifact_parsers.hpp"
+#include "porytiles/infra/services/palette_manifest.hpp"
+#include "porytiles/xcut/config/unwrap_config.hpp"
+
+namespace porytiles {
+
+ChainableResult<void> load_project_metatiles(
+    PorymapTilesetComponent &dest,
+    const std::string &tileset_name,
+    bool is_secondary,
+    const std::filesystem::path &project_root,
+    const std::filesystem::path &metatiles_path,
+    const DomainConfig &config,
+    const FilePaletteLoader &palette_loader)
+{
+    PT_TRY_ASSIGN_CHAIN_ERR(
+        tile_id_layout,
+        resolve_tile_id_layout(config, tileset_name),
+        void,
+        "Failed to resolve the tile id layout of '{}'.",
+        FormatParam{tileset_name, Style::bold});
+    const auto absolute_metatiles_path = project_root / metatiles_path;
+    PT_TRY_ASSIGN_PASS_ERR(
+        entries, read_metatiles_with_tiles_ext(absolute_metatiles_path, tile_id_layout.layout), void);
+
+    PT_UNWRAP_TILESET_CONFIG_REF(config, extra_palettes, tileset_name, void);
+    PT_UNWRAP_TILESET_CONFIG_REF(config, num_palettes_total, tileset_name, void);
+    const PaletteManifest manifest{project_root};
+    PT_TRY_ASSIGN_PASS_ERR(manifest_entry, manifest.entry_for(tileset_name), void);
+
+    if (manifest_entry.has_value() || (extra_palettes.value() && is_secondary)) {
+        const std::size_t base = num_palettes_total.value();
+        dest.enable_extra_palettes(base, PaletteManifestEntry::num_extra_palettes);
+        if (manifest_entry.has_value()) {
+            const auto refs_path = project_root / manifest_entry->palette_refs;
+            if (std::filesystem::exists(refs_path)) {
+                std::ifstream in{absolute_metatiles_path, std::ios::binary};
+                const std::vector<std::uint8_t> metatiles_bin{std::istreambuf_iterator<char>(in), {}};
+                PT_TRY_CALL_PASS_ERR(
+                    apply_palette_refs(
+                        refs_path, metatiles_bin, entries, base + PaletteManifestEntry::num_extra_palettes),
+                    void);
+            }
+            for (std::size_t i = 0; i < PaletteManifestEntry::num_extra_palettes; ++i) {
+                const auto palette_path = project_root / manifest_entry->palettes.at(i);
+                if (!std::filesystem::exists(palette_path)) {
+                    continue;
+                }
+                PT_TRY_ASSIGN_PASS_ERR(palette, load_porymap_palette(palette_path, palette_loader), void);
+                dest.set_extra_palette(i, std::move(palette));
+            }
+        }
+    }
+
+    for (auto &entry : entries) {
+        dest.push_back_tilemap_entry(std::move(entry));
+    }
+    return {};
+}
+
+} // namespace porytiles

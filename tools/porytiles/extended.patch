diff --git a/porytiles/include/porytiles/domain/config/tile_id_layout_resolver.hpp b/porytiles/include/porytiles/domain/config/tile_id_layout_resolver.hpp
new file mode 100644
index 0000000..2dbd22a
--- /dev/null
+++ b/porytiles/include/porytiles/domain/config/tile_id_layout_resolver.hpp
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstddef>
+#include <optional>
+#include <string>
+
+#include "porytiles/domain/config/domain_config.hpp"
+#include "porytiles/domain/models/tile_id_layout.hpp"
+#include "porytiles/utilities/result/chainable_result.hpp"
+#include "porytiles/xcut/config/config_value.hpp"
+
+namespace porytiles {
+
+/// @brief A tileset's TileIdLayout plus the config values that set its limits, for diagnostics.
+struct ResolvedTileIdLayout {
+    TileIdLayout layout;
+
+    /// @brief The value that sets the primary tile limit: num_tiles_in_primary, or its extended counterpart.
+    ConfigValue<std::size_t> primary_limit;
+
+    /// @brief num_tiles_total, whose difference with primary_limit is the secondary limit in a vanilla layout.
+    ConfigValue<std::size_t> total_limit;
+
+    /// @brief num_tiles_in_secondary_extended when the layout is extended, nullopt otherwise.
+    std::optional<ConfigValue<std::size_t>> secondary_limit;
+};
+
+/// @brief Builds the TileIdLayout a tileset's config describes.
+///
+/// @details
+/// The layout is extended when num_tiles_in_primary_extended and num_tiles_in_secondary_extended are both nonzero,
+/// and the identity layout when both are zero. Anything else is an error.
+[[nodiscard]] ChainableResult<ResolvedTileIdLayout>
+resolve_tile_id_layout(const DomainConfig &config, const std::string &tileset_name);
+
+} // namespace porytiles

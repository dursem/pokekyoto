+        "Failed to get tileset bin path config for '{}'.",
+        FormatParam(tileset_name, Style::bold));
+    PT_TRY_CALL_CHAIN_ERR(
+        incbin_appender_->append_graphics_declarations(tileset_name, bin_path_base, palette::num_palettes, false),
+        bool,
+        "Failed to declare uncompressed tiles for '{}'.",
+        FormatParam(tileset_name, Style::bold));
+    PT_TRY_CALL_CHAIN_ERR(
+        metadata_writer_->update_fields(tileset_name, {{"isCompressed", "FALSE"}}),
+        bool,
+        "Failed to mark '{}' uncompressed in headers.h.",
+        FormatParam(tileset_name, Style::bold));
+    metadata_provider_->invalidate_metadata_cache();
+    return true;
+}

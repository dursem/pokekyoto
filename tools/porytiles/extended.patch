+++ b/porytiles/lib/domain/models/tile_id_layout.cpp
@@ -0,0 +1,67 @@
+#include "porytiles/domain/models/tile_id_layout.hpp"
+
+#include "porytiles/utilities/panic/panic.hpp"
+
+namespace porytiles {
+
+TileIdLayout::TileIdLayout(std::size_t hw_primary, std::size_t hw_total)
+    : TileIdLayout{hw_primary, hw_total, hw_primary, hw_total - hw_primary, false}
+{
+}
+
+TileIdLayout::TileIdLayout(
+    std::size_t hw_primary, std::size_t hw_total, std::size_t primary, std::size_t secondary, bool extended)
+    : hw_primary_{hw_primary}, hw_total_{hw_total}, primary_{primary}, secondary_{secondary}, extended_{extended}
+{
+    assert_or_panic(hw_primary <= hw_total, "TileIdLayout: hw_primary must not exceed hw_total");
+}
+
+std::optional<TileIdLayout>
+TileIdLayout::extended(std::size_t hw_primary, std::size_t hw_total, std::size_t ext_primary, std::size_t ext_secondary)
+{
+    const std::size_t hw_secondary = hw_total - hw_primary;
+    if (ext_primary < hw_primary || ext_secondary < hw_secondary ||
+        ext_primary + ext_secondary > (std::size_t{1} << game_id_bits)) {
+        return std::nullopt;
+    }
+    return TileIdLayout{hw_primary, hw_total, ext_primary, ext_secondary, true};
+}
+
+std::optional<std::size_t> TileIdLayout::to_internal(std::size_t game_id) const
+{
+    const std::size_t hw_secondary = hw_total_ - hw_primary_;
+    const std::size_t primary_high = primary_ - hw_primary_;
+    if (game_id < hw_primary_) {
+        return game_id;
+    }
+    if (game_id < hw_total_) {
+        return primary_ + (game_id - hw_primary_);
+    }
+    if (game_id < hw_total_ + primary_high) {
+        return hw_primary_ + (game_id - hw_total_);
+    }
+    const std::size_t secondary_high_index = game_id - hw_total_ - primary_high;
+    if (secondary_high_index >= secondary_ - hw_secondary) {
+        return std::nullopt;
+    }
+    return primary_ + hw_secondary + secondary_high_index;
+}
+
+std::size_t TileIdLayout::to_game(std::size_t internal_id) const
+{
+    assert_or_panic(internal_id < num_tiles_total(), "TileIdLayout::to_game: internal id out of range");
+    const std::size_t hw_secondary = hw_total_ - hw_primary_;
+    const std::size_t primary_high = primary_ - hw_primary_;
+    if (internal_id < hw_primary_) {
+        return internal_id;
+    }
+    if (internal_id < primary_) {
+        return hw_total_ + (internal_id - hw_primary_);
+    }
+    if (internal_id < primary_ + hw_secondary) {
+        return hw_primary_ + (internal_id - primary_);
+    }
+    return hw_total_ + primary_high + (internal_id - primary_ - hw_secondary);
+}
+
+} // namespace porytiles

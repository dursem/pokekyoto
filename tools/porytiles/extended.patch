diff --git a/porytiles/include/porytiles/infra/algorithms/extended_tileset_formats.hpp b/porytiles/include/porytiles/infra/algorithms/extended_tileset_formats.hpp
new file mode 100644
index 0000000..3fa4b4e
--- /dev/null
+++ b/porytiles/include/porytiles/infra/algorithms/extended_tileset_formats.hpp
@@ -0,0 +1,78 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "porytiles/domain/models/tile_id_layout.hpp"
+#include "porytiles/domain/models/tilemap_entry.hpp"
+#include "porytiles/utilities/result/chainable_result.hpp"
+
+namespace porytiles {
+
+/*
+ * Sidecar files of the project's extended tilesets (docs/TILESET_CAPACITY_GUIDE.md and docs/MAP_PALETTES.md in
+ * the project):
+ *
+ * metatile_tiles_ext.bin sits next to metatiles.bin and holds one byte per tilemap entry, in the same order. Bits 5-6
+ * are bits 10-11 of the entry's game tile id (see TileIdLayout); the other bits are reserved and written as zero. A
+ * tileset only has the file once one of its entries needs the high bits.
+ *
+ * palette_refs.json holds the logical palette of every entry of a secondary tileset with extra palettes:
+ *   {"version": 1, "metatiles_sha256": "<sha256 of metatiles.bin>", "palettes": [[12 ids], [12 ids], ...]}
+ * The checksum binds it to the exact metatiles.bin written with it. Entries whose logical palette is an extra palette
+ * store palette 0 in metatiles.bin.
+ */
+
+inline constexpr auto metatile_tiles_ext_filename = "metatile_tiles_ext.bin";
+inline constexpr auto palette_refs_filename = "palette_refs.json";
+inline constexpr std::size_t metatile_tiles_ext_high_shift = 5;
+inline constexpr std::uint8_t metatile_tiles_ext_high_mask = 0x3 << metatile_tiles_ext_high_shift;
+
+/// @brief metatiles.bin, metatile_tiles_ext.bin and palette_refs.json contents for a set of tilemap entries.
+struct EncodedMetatiles {
+    std::vector<std::uint8_t> metatiles_bin;
+    std::vector<std::uint8_t> tiles_ext;
+    /// @brief True when an entry needs tile id bits 10-11, so metatile_tiles_ext.bin must be written.
+    bool needs_tiles_ext{false};
+    /// @brief The palette_refs.json text, when the entries were encoded with extra palettes.
+    std::optional<std::string> palette_refs_json;
+};
+
+/// @brief Reads metatiles.bin and, when present beside it, metatile_tiles_ext.bin into entries with contiguous tile
+/// ids.
+///
+/// @param metatiles_path Absolute path to metatiles.bin
+/// @param layout The project's tile id layout
+/// @return The entries, or an error for a malformed file, a sidecar of the wrong size, or a tile id outside the layout
+[[nodiscard]] ChainableResult<std::vector<TilemapEntry>>
+read_metatiles_with_tiles_ext(const std::filesystem::path &metatiles_path, const TileIdLayout &layout);
+
+/// @brief Replaces each entry's palette with its logical palette from palette_refs.json.
+///
+/// @param refs_path Absolute path to palette_refs.json
+/// @param metatiles_bin The metatiles.bin bytes the refs must match
+/// @param entries The entries parsed from @p metatiles_bin
+/// @param max_logical_palettes Palette ids must be below this
+[[nodiscard]] ChainableResult<void> apply_palette_refs(
+    const std::filesystem::path &refs_path,
+    const std::vector<std::uint8_t> &metatiles_bin,
+    std::vector<TilemapEntry> &entries,
+    std::size_t max_logical_palettes);
+
+/// @brief Encodes entries with contiguous tile ids into the project's files.
+///
+/// @param entries Tilemap entries with contiguous tile ids and logical palettes
+/// @param layout The project's tile id layout
+/// @param extra_palette_base First extra palette id when the tileset has extra palettes, nullopt otherwise
+/// @param entries_per_metatile Tilemap entries per metatile (8 or 12), the width of each palette_refs.json row
+[[nodiscard]] ChainableResult<EncodedMetatiles> encode_metatiles(
+    const std::vector<TilemapEntry> &entries,
+    const TileIdLayout &layout,
+    std::optional<std::size_t> extra_palette_base,
+    std::size_t entries_per_metatile);
+
+} // namespace porytiles

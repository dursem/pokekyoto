@@ -0,0 +1,95 @@
+#pragma once
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonArray>
+#include <QJsonObject>
+#include <QCryptographicHash>
+#include <QSaveFile>
+#include <QStringList>
+#include <QVector>
+
+namespace OpalPalettes {
+// Kyoto Emerald uses 8 sub-tiles per metatile. These helpers intentionally accept the project-provided column count instead of hard-coding Opal's original 12.
+inline bool readJson(const QString &path, QJsonDocument &doc, QString &error) {
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) { error = path + ": " + file.errorString(); return false; }
+    QJsonParseError parse;
+    doc = QJsonDocument::fromJson(file.readAll(), &parse);
+    if (parse.error != QJsonParseError::NoError) { error = path + ": " + parse.errorString(); return false; }
+    return true;
+}
+inline bool readReferences(const QString &path, const QByteArray &metatiles, int rows, int columns, QVector<QVector<int>> &refs, QString &error) {
+    QJsonDocument doc;
+    if (!readJson(path, doc, error)) return false;
+    error = QString("%1: expected one row of %2 IDs (0–17) per metatile, with a matching binary checksum")
+            .arg(path).arg(columns);
+    const auto root = doc.object();
+    const auto digest = QString::fromLatin1(QCryptographicHash::hash(metatiles, QCryptographicHash::Sha256).toHex());
+    if (columns <= 0 || !doc.isObject() || root.value("version").toInt() != 1
+        || root.value("metatiles_sha256").toString() != digest
+        || !root.value("palettes").isArray() || root.value("palettes").toArray().size() != rows) return false;
+    QVector<QVector<int>> result;
+    for (const auto &value : root.value("palettes").toArray()) {
+        if (!value.isArray() || value.toArray().size() != columns) return false;
+        QVector<int> row;
+        for (const auto &id : value.toArray()) {
+            if (!id.isDouble() || id.toDouble() != id.toInt(-1) || id.toInt(-1) < 0 || id.toInt() >= 18) return false;
+            row.append(id.toInt());
+        }
+        result.append(row);
+    }
+    refs = result;
+    error.clear();
+    return true;
+}
+inline bool writeReferences(const QString &path, const QVector<QVector<int>> &refs, const QByteArray &metatiles, QString &error) {
+    QJsonArray rows;
+    const int columns = refs.isEmpty() ? 0 : refs.first().size();
+    if (columns <= 0) { error = "Kyoto/Opal palette sidecar has no metatile columns"; return false; }
+    for (const auto &row : refs) {
+        if (row.size() != columns) { error = "Kyoto/Opal palette rows have inconsistent sub-tile counts"; return false; }
+        QJsonArray values;
+        for (int id : row) {
+            if (id < 0 || id >= 18) { error = "Invalid Opal palette ID"; return false; }
+            values.append(id);
+        }
+        rows.append(values);
+    }
+    QJsonObject root;
+    root.insert("version", 1);
+    root.insert("metatiles_sha256", QString::fromLatin1(QCryptographicHash::hash(metatiles, QCryptographicHash::Sha256).toHex()));
+    root.insert("palettes", rows);
+    QSaveFile file(path);
+    const auto bytes = QJsonDocument(root).toJson();
+    if (!file.open(QIODevice::WriteOnly) || file.write(bytes) != bytes.size() || !file.commit()) {
+        error = path + ": " + file.errorString(); return false;
+    }
+    return true;
+}
+inline bool tilesetPaths(const QString &root, const QString &name, QString &refs, QStringList &palettes, QString &error) {
+    const QString path = root + "/data/tilesets/opal_palettes.json";
+    if (!QFile::exists(path)) return true;
+    QJsonDocument doc;
+    if (!readJson(path, doc, error)) return false;
+    const auto obj = doc.object();
+    error = path + ": invalid or duplicate Opal tileset entry";
+    if (obj.value("version").toInt() != 1 || !obj.value("tilesets").isArray()) return false;
+    bool found = false;
+    for (const auto &value : obj.value("tilesets").toArray()) {
+        const auto entry = value.toObject();
+        if (entry.value("tileset").toString() != name) continue;
+        if (found || entry.value("palette_refs").toString().isEmpty() || entry.value("palettes").toArray().size() != 4) return false;
+        found = true;
+        refs = root + "/" + entry.value("palette_refs").toString();
+        while (palettes.size() < 18) palettes.append(QString());
+        const auto extra = entry.value("palettes").toArray();
+        for (int i = 0; i < 4; i++) {
+            const auto day = extra[i].toObject().value("day").toString();
+            if (day.isEmpty()) return false;
+            palettes[14 + i] = root + "/" + day;
+        }
+    }
+    error.clear();
+    return true;
+}
+}

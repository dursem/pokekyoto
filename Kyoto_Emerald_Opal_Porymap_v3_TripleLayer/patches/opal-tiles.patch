diff --git a/include/opaltiles.h b/include/opaltiles.h
new file mode 100644
index 00000000..82276284
--- /dev/null
+++ b/include/opaltiles.h
@@ -0,0 +1,62 @@
+#pragma once
+#ifndef OPALTILES_H
+#define OPALTILES_H
+
+#include <QByteArray>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QSaveFile>
+#include <QString>
+
+// Opal's streamed tilesets (docs/TILESET_CAPACITY_GUIDE.md) give primary tilesets up to 1024 tiles and secondary
+// tilesets up to 2048. metatiles.bin keeps the 10-bit hardware tile field, and metatile_tiles_ext.bin holds bits
+// 10-11 of each sub-tile's tile id (bits 5-6 of one byte per sub-tile). The game numbers tiles so that old ids keep
+// their meaning:
+//   [0, 512) primary 0-511, [512, 1024) secondary 0-511, [1024, 1536) primary 512-1023, [1536, 3072) secondary 512-2047
+// Porymap works with contiguous ids instead (primary [0, 1024), secondary [1024, 3072)); these convert between them.
+namespace OpalTiles {
+
+constexpr int LegacyTilesPrimary = 512;
+constexpr int LegacyTilesTotal = 1024;
+constexpr int TilesPrimary = 1024;
+constexpr int TilesTotal = 3072;
+constexpr int ExtHighShift = 5;
+constexpr int ExtHighMask = 0x3 << ExtHighShift;
+
+inline int gameToEditor(int tile) {
+    if (tile < LegacyTilesPrimary) return tile;
+    if (tile < LegacyTilesTotal) return TilesPrimary + tile - LegacyTilesPrimary;
+    if (tile < LegacyTilesTotal + LegacyTilesPrimary) return tile - LegacyTilesPrimary;
+    return tile;
+}
+
+inline int editorToGame(int tile) {
+    if (tile < LegacyTilesPrimary) return tile;
+    if (tile < TilesPrimary) return tile + LegacyTilesPrimary;
+    if (tile < TilesPrimary + LegacyTilesPrimary) return tile - TilesPrimary + LegacyTilesPrimary;
+    return tile;
+}
+
+inline QString extPath(const QString &metatilesPath) {
+    return QFileInfo(metatilesPath).dir().filePath("metatile_tiles_ext.bin");
+}
+
+inline QByteArray readExt(const QString &metatilesPath) {
+    QFile file(extPath(metatilesPath));
+    if (!file.open(QIODevice::ReadOnly)) return QByteArray();
+    return file.readAll();
+}
+
+inline bool writeExt(const QString &metatilesPath, const QByteArray &ext, QString *error) {
+    QSaveFile file(extPath(metatilesPath));
+    if (!file.open(QIODevice::WriteOnly) || file.write(ext) != ext.size() || !file.commit()) {
+        *error = QString("Could not save %1: %2").arg(extPath(metatilesPath), file.errorString());
+        return false;
+    }
+    return true;
+}
+
+} // namespace OpalTiles
+
+#endif // OPALTILES_H

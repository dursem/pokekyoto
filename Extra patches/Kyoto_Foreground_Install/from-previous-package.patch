diff --git a/include/kyoto_cloud_config.h b/include/kyoto_cloud_config.h
index 8d165e4662f96930a16e9f6e38436f929485e2be..db0648d4c33e13b30299eaa51aff0875f29342c0 100644
--- a/include/kyoto_cloud_config.h
+++ b/include/kyoto_cloud_config.h
@@ -1,24 +1,7 @@
 #ifndef GUARD_KYOTO_CLOUD_CONFIG_H
 #define GUARD_KYOTO_CLOUD_CONFIG_H
 
-/* Configure these for the destination project. The defaults match Kyoto's test map.
- * The logical tile expansion is owned by the host project, not by this renderer.
- * Physical BG2 (normal) or BG3 (triple) entries must mark ONLY cloud surfaces
- * with this palette. Keep ordinary rocks/roads on other palettes. */
-#define KYOTO_CLOUD_MAP_GROUP 0
-#define KYOTO_CLOUD_MAP_NUM   9
-#define KYOTO_CLOUD_SOURCE_PALETTE 0xFF /* auto-detect physical palette from the imported colors */
-#define KYOTO_CLOUD_BG_PALETTE 13
-#define KYOTO_CLOUD_MAP_ENABLED() \
-    (gSaveBlock1Ptr->location.mapGroup == KYOTO_CLOUD_MAP_GROUP \
-     && gSaveBlock1Ptr->location.mapNum == KYOTO_CLOUD_MAP_NUM)
-/* BG character block 2: tile 0 blank, 1..31 native BG3 cache, 32..255 cloud atlas.
- * BG0 start-menu text (313..396) and frame tiles (532..540) stay outside this area.
- * Palette 13 must be reserved on enabled maps. */
-#define KYOTO_CLOUD_NATIVE_CACHE_LIMIT 32
+// Foreground weather only: no BG tile, tilemap or BG palette reservations.
 #define KYOTO_CLOUD_CODE_BUFFER_WORDS 208
-#endif
 
-#if KYOTO_CLOUD_BG_PALETTE != 13 || KYOTO_CLOUD_NATIVE_CACHE_LIMIT != 32 || KYOTO_CLOUD_CODE_BUFFER_WORDS != 208
-#error This packed atlas/kernel layout requires palette 13, 32 native-cache slots and an 832-byte code buffer.

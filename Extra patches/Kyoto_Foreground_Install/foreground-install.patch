diff --git a/src/kyoto_cloud_layers.c b/src/kyoto_cloud_layers.c
new file mode 100644
index 0000000000000000000000000000000000000000..a10920897fd44db5a93d50f5b5457bac314532dc
--- /dev/null
+++ b/src/kyoto_cloud_layers.c
@@ -0,0 +1,319 @@
+#include "global.h"
+#include "field_camera.h"
+#include "field_weather.h"
+#include "main.h"
+#include "malloc.h"
+#include "overworld.h"
+#include "palette.h"
